<?xml version="1.0"?>
<ruleset name="WPHZ UGC Carousel">
    <description>PHPCS rules for the WPHZ UGC Carousel plugin.</description>

    <arg name="basepath" value="."/>
    <arg value="sp"/>
    <arg name="colors"/>
    <config name="testVersion" value="8.0-"/>

    <!-- Only scan PHP files. This naturally excludes JS/CSS. -->
    <arg name="extensions" value="php"/>

    <file>src</file>
    <file>templates</file>
    <file>wphz-ugc-carousel.php</file>
    <file>debug.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>
    <!-- PSR-4 class files in src/ use CamelCase names, not WordPress class-*.php naming. -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>*/src/*</exclude-pattern>
    </rule>
    <rule ref="PHPCompatibilityWP">
        <properties>
            <property name="testVersion" value="8.0-"/>
        </properties>
    </rule>
</ruleset>
